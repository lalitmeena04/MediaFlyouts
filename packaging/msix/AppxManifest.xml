<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for MediaFlyouts.

  Before packaging:
    * The Publisher below MUST match the subject of the code-signing certificate
      used to sign the .msix, e.g. "CN=MediaFlyouts".
    * Add the logo PNGs referenced under Images/ (see packaging/README.md).
    * The Version must be 4 parts (a.b.c.d); the release workflow injects it.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">

  <Identity
      Name="MediaFlyouts"
      Publisher="CN=MediaFlyouts"
      Version="1.2.0.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MediaFlyouts</DisplayName>
    <PublisherDisplayName>MediaFlyouts</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
    <Description>Modern media, volume and lock-key flyouts for Windows.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="MediaFlyouts" Executable="MediaFlyouts.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="MediaFlyouts"
          Description="Modern media, volume and lock-key flyouts for Windows."
          BackgroundColor="transparent"
          Square150x150Logo="Images\Square150x150Logo.png"
          Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" Square71x71Logo="Images\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="MediaFlyoutsStartupTask" Enabled="true" DisplayName="MediaFlyouts" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
